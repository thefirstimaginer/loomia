#!/bin/bash
# AppRun — ponto de entrada do AppImage do Loomia.
#
# O 1º clique: registra loomia:// (uma vez), abre a janela "Cliente Loomia
# Pronto" e sobe o ícone da bandeja.
# Cliques seguintes (inclusive vindo do site): abrem a mesma instância e
# entregam o link, que inicia o jogo na sala escolhida.

set -e

HERE="$(dirname "$(readlink -f "$0")")"
export APPDIR="${APPDIR:-$HERE}"
export PATH="$APPDIR/usr/bin:$PATH"
export PYTHONPATH="$APPDIR/usr/lib/loomia${PYTHONPATH:+:$PYTHONPATH}"

# Nome curto e estável do cliente (é o que vai no .desktop registrado).
export LOOMIA_CLIENT_BIN="${LOOMIA_CLIENT_BIN:-$APPDIR/usr/bin/loomia-client}"

# O site e a sala são locais por padrão (dev); o link loomia:// pode trazer outro.
export LOOMIA_MASTER="${LOOMIA_MASTER:-http://127.0.0.1:8080}"
export LOOMIA_BRIDGE_PORT="${LOOMIA_BRIDGE_PORT:-7788}"
export LOOMIA_ENGINE="${LOOMIA_ENGINE:-$APPDIR/usr/bin/loomiaengine}"
export LOOMIA_GAME_DIR="${LOOMIA_GAME_DIR:-$APPDIR/usr/share/loomia/game}"

exec python3 "$APPDIR/usr/lib/loomia/loomia-client.py" "$@"
